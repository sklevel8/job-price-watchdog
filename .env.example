# Copy to .env for local runs. Never commit .env.
# Create a Discord webhook: Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# Optional Telegram delivery (either or both channels may be configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional runtime overrides
# WATCHDOG_DB_PATH=state/watchdog.db
# WATCHDOG_LOG_LEVEL=INFO
# WATCHDOG_DRY_RUN=true
